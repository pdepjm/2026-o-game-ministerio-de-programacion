import wollok.game.*
import example.*

program laberinto {
  game.width(15)
  game.height(10)
  game.cellSize(50)
  game.title("Laberinto")
  

  const mapaNivel1 = [
    ["P","P","P","M","M","M","M","M","M","M","M","M","M","M","S"],
    ["P","M","P","P","M","P","P","P","V","M","M","M","M","P","P"],
    ["P","M","M","M","M","P","M","M","M","M","M","M","M","P","M"],
    ["P","M","M","M","P","P","L","P","P","P","P","P","P","P","M"],
    ["P","M","M","M","M","M","M","M","M","M","M","M","M","P","M"],
    ["P","M","P","P","P","P","P","P","M","M","M","P","P","P","M"],
    ["P","M","P","M","M","P","M","M","M","P","M","M","M","P","M"],
    ["M","E","P","M","M","P","P","M","M","P","P","M","P","P","M"],
    ["M","M","P","M","M","M","M","M","M","M","M","M","M","O","M"],
    ["P","P","P","P","P","P","P","P","P","P","P","P","P","P","M"]
  ]

  nivel.cargarMapa(mapaNivel1)
  game.addVisual(personaje)
  game.addVisual(textoEnergia)
  game.addVisual(textoEstado)

  keyboard.up().onPressDo { personaje.moverse(0, 1) }
  keyboard.down().onPressDo { personaje.moverse(0, -1) }
  keyboard.left().onPressDo { personaje.moverse(-1, 0) }
  keyboard.right().onPressDo { personaje.moverse(1, 0) }

  game.start()
}

program laberinto {
    //tablero
    game.width(15) //ancho
    game.height(10) //alto
    game.cellSize(50) //pixel por celda
    game.title("Laberinto")

	
	//matriz del nivel m=muro p=pasillo e=trampa.energia v=trampa.velocidad l=llave o=pocion
	 const mapaNivel1 = [
        ["P","P","P","M","M","M","M","M","M","M","M","M","M","M","P"],
        ["P","M","P","P","M","P","P","P","V","M","M","M","M","P","P"],
        ["P","M","M","M","M","P","M","M","M","M","M","M","M","P","M"],
        ["P","M","M","M","P","P","P","P","P","P","P","P","P","L","M"],
        ["P","M","M","M","M","M","M","P","M","M","M","M","M","P","M"],
        ["P","M","P","P","P","P","P","P","M","M","M","P","P","P","M"],
        ["P","M","P","M","M","P","M","M","M","P","M","M","M","P","M"],
        ["M","E","P","M","M","P","P","M","M","P","P","M","P","P","M"],
        ["M","M","P","M","M","M","M","M","M","M","M","M","M","O","M"],
        ["P","P","P","P","P","P","P","P","P","P","P","P","P","P","M"]
    ]

	nivel.cargarMapa(mapaNivel1)
	game.addVisual(personaje) 
	//habria que agregar cuando pisa la llave y desaparece prox entrega

    keyboard.up().onPressDo { personaje.moverse(0, 1) }
    keyboard.down().onPressDo { personaje.moverse(0, -1) }
    keyboard.left().onPressDo { personaje.moverse(-1, 0) }
    keyboard.right().onPressDo { personaje.moverse(1, 0) }

    game.start()
}


import wollok.game.*
import personaje.*
import tablero.*
import elementos.*
import juego.*
import main.*
import fantasmas.*
import nivel.*
import niveles.*
import textos.*
import letras.*

describe "Personaje y elementos" {

  method initialize() {
    game.width(tablero.ancho())
    game.height(tablero.alto() + 1)
    personaje.reiniciar()
    personaje.ubicarEnInicio(game.at(1, 1))
  }

  test "moverse gasta 2 de energía" {
    personaje.moverse(new Derecha())
    assert.equals(game.at(2, 1), personaje.position())
    assert.equals(98, personaje.energia())
  }

  test "un muro no deja pasar" {
    game.addVisual(new Muro(position = game.at(2, 1)))
    personaje.moverse(new Derecha())
    assert.equals(game.at(1, 1), personaje.position())
  }

  test "no se puede salir del tablero" {
    personaje.ubicarEnInicio(game.at(0, 0))
    personaje.moverse(new Izquierda())
    assert.equals(game.at(0, 0), personaje.position())
  }

  test "no se puede entrar a la fila del texto" {
    personaje.ubicarEnInicio(game.at(1, tablero.alto() - 1))
    personaje.moverse(new Arriba())
    assert.equals(game.at(1, tablero.alto() - 1), personaje.position())
  }

  test "la poción recupera energía y desaparece" {
    personaje.perderEnergia(50)
    const pocion = new Pocion(position = game.at(2, 1))
    game.addVisual(pocion)
    personaje.moverse(new Derecha())
    assert.equals(68, personaje.energia())
    assert.notThat(game.hasVisual(pocion))
  }

  test "la energía no supera 100" {
    personaje.recuperarEnergia(50)
    assert.equals(100, personaje.energia())
  }

  test "la llaves es recogida y desaparece" {
    const llave = new Llave(position = game.at(2, 1))
    game.addVisual(llave)
    personaje.moverse(new Derecha())
    assert.that(personaje.tieneLlave())
    assert.notThat(game.hasVisual(llave))
  }

  test "la trampa de energía resta 15" {
    game.addVisual(new TrampaEnergia(position = game.at(2, 1)))
    personaje.moverse(new Derecha())
    assert.equals(83, personaje.energia())
  }

  test "la trampa de velocidad hace que cada paso cueste 4" {
    game.addVisual(new TrampaVelocidad(position = game.at(2, 1)))
    personaje.moverse(new Derecha())       // pisa la trampa: -2
    personaje.moverse(new Derecha())       // ya está lento: -4
    assert.equals(94, personaje.energia())
  }

  test "después de 5 pasos lentos vuelve a caminar normal" {
    personaje.ralentizar()
    5.times({ i => personaje.moverse(new Derecha()) })
    assert.equals(80, personaje.energia())
    assert.equals(pasoNormal, personaje.paso())
  }

  test "los pinches sacan una vida y vuelven al inicio" {
    game.addVisual(new Pinches(position = game.at(2, 1)))
    personaje.moverse(new Derecha())
    assert.equals(2, personaje.vida())
    assert.equals(game.at(1, 1), personaje.position())
  }

  test "la salida sin llave no hace nada" {
    new Salida(position = game.at(2, 1)).efecto(personaje)
    assert.equals(nivel1, juego.nivelActual())
  }

  test "quedarse sin energía termina el juego" {
    personaje.perderEnergia(100)
    assert.equals("Game Over: te quedaste sin energía", textoEstado.text())
  }

  test "perder las 3 vidas termina el juego" {
    3.times({ i => personaje.perderVida() })
    assert.equals(0, personaje.vida())
    assert.equals("Game Over: te quedaste sin vidas", textoEstado.text())
  }
}

describe "Fantasmas" {

  method initialize() {
    game.width(tablero.ancho())
    game.height(tablero.alto() + 1)
    personaje.reiniciar()
    personaje.ubicarEnInicio(game.at(1, 1))
  }

  test "el fantasma horizontal se mueve en horizontal" {
    const fantasma = new Fantasma(position = game.at(5, 5))
    fantasma.mover()
    assert.equals(game.at(6, 5), fantasma.position())
  }

  test "el fantasma vertical se mueve hacia arriba" {
    const fantasma = new FantasmaVertical(position = game.at(5, 5))
    fantasma.mover()
    assert.equals(game.at(5, 6), fantasma.position())
  }

  test "el fantasma cambia de sentido al chocar un muro" {
    game.addVisual(new Muro(position = game.at(6, 5)))
    const fantasma = new Fantasma(position = game.at(5, 5))
    fantasma.mover()
    fantasma.mover()
    assert.equals(game.at(4, 5), fantasma.position())
  }

  test "si el fantasma toca al personaje le saca una vida" {
    const fantasma = new Fantasma(position = game.at(0, 1))
    fantasma.mover()
    assert.equals(2, personaje.vida())
  }

  test "si el personaje pisa un fantasma pierde una vida" {
    game.addVisual(new Fantasma(position = game.at(2, 1)))
    personaje.moverse(new Derecha())
    assert.equals(2, personaje.vida())
  }
}

describe "Mapa y niveles" {

  method initialize() {
    game.width(tablero.ancho())
    game.height(tablero.alto() + 1)
  }

  test "la letra m dibuja un muro" {
    m.decode(3, 3, nivel1)
    assert.that(tablero.hayObstaculoEn(game.at(3, 3)))
  }

  test "la letra l pone un pasillo y una llave" {
    l.decode(3, 3, nivel1)
    assert.equals(2, game.getObjectsIn(game.at(3, 3)).size())
  }

  test "la letra p ubica al personaje en el inicio" {
    p.decode(4, 4, nivel1)
    assert.equals(game.at(4, 4), personaje.position())
  }

  test "la letra f anota un fantasma en el nivel" {
    f.decode(3, 3, nivel1)
    assert.equals(1, nivel1.fantasmas().size())
  }

  test "al jugar arranca el nivel 1 con el personaje en el inicio" {
    juego.jugar()
    assert.equals(nivel1, juego.nivelActual())
    assert.equals(game.at(0, 0), personaje.position())
  }

  test "el nivel 1 tiene 2 fantasmas" {
    juego.jugar()
    assert.equals(2, nivel1.fantasmas().size())
  }

  test "llegar a la salida con la llave pasa al nivel 2" {
    juego.jugar()
    personaje.agarrarLlave()
    new Salida(position = game.at(1, 1)).efecto(personaje)
    assert.equals(nivel2, juego.nivelActual())
  }

  test "al pasar de nivel se conservan las vidas pero no la llave" {
    juego.jugar()
    personaje.perderVida()
    personaje.agarrarLlave()
    juego.nivelCompletado()
    assert.equals(2, personaje.vida())
    assert.notThat(personaje.tieneLlave())
  }

  test "completar el nivel 2 pasa al nivel 3, que tiene 3 fantasmas" {
    juego.jugar()
    juego.nivelCompletado()
    juego.nivelCompletado()
    assert.equals(nivel3, juego.nivelActual())
    assert.equals(3, nivel3.fantasmas().size())
  }

  test "el siguiente nivel del último es la victoria" {
    assert.equals(victoria, nivel3.siguienteNivel())
  }

  test "completar el último nivel gana el juego" {
    juego.jugar()
    3.times({ i => juego.nivelCompletado() })
    assert.equals("Has Escapado!!!", textoEstado.text())
  }
}
